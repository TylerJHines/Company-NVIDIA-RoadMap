import {firebaseConfig} from './aio/firebase-config.js';
const SDK='https://www.gstatic.com/firebasejs/11.10.0/';
const escapeHTML=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const personalDomains=new Set(['gmail.com','googlemail.com','yahoo.com','yahoo.co.uk','outlook.com','hotmail.com','live.com','msn.com','icloud.com','me.com','aol.com','proton.me','protonmail.com','mail.com','gmx.com','comcast.net','att.net','verizon.net','yandex.com']);
let auth,db,F,user=null,companyId='',company=null,member=null,request=null,members=[],requests=[],loading=true,message='',error=false,active=false,seq=0;
const emit=()=>window.dispatchEvent(new Event('academy-team-changed'));
const notice=(msg,isError=false)=>{message=msg;error=isError;emit()};
const companyRef=()=>F.doc(db,'companies',companyId);
const memberRef=uid=>F.doc(db,'companies',companyId,'members',uid);
const requestRef=uid=>F.doc(db,'companies',companyId,'requests',uid);
const isAdmin=()=>Boolean(user&&company?.adminUid===user.uid);
const isApproved=()=>Boolean(member?.status==='active'||isAdmin());
const certCodes=['NCA-AIIO','NCP-AII','NCA-APC','NCP-ARI','NCP-AIN','NCP-AIO'];
const summary=()=>{const checks=window.AcademyProgress?.get?.()||{};const completed=Object.values(checks).filter(Boolean).length;const total=Object.values(window.ACADEMY_DATA?.resources||{}).reduce((n,x)=>n+x.length,0);const certifications=(window.AcademyBadges?.getCodes?.()||[]).filter(x=>certCodes.includes(x));return {completed,total,certifications,updatedAt:new Date().toISOString()}};
const refresh=async()=>{if(!user||!company||!isApproved())return;const token=seq;try{const [m,r]=await Promise.all([F.getDocs(F.collection(db,'companies',companyId,'members')),isAdmin()?F.getDocs(F.collection(db,'companies',companyId,'requests')):Promise.resolve(null)]);if(token!==seq)return;members=m.docs.map(d=>({uid:d.id,...d.data()})).filter(x=>x.status==='active');requests=r?r.docs.map(d=>({uid:d.id,...d.data()})):[];emit()}catch(e){notice('Unable to load team data: '+(e.code||e.message),true)}};
async function initialize(u){const token=++seq;user=u;companyId='';company=null;member=null;request=null;members=[];requests=[];message='';loading=true;emit();if(!u){loading=false;emit();return}const email=(u.email||'').toLowerCase();const domain=email.split('@')[1]||'';if(!u.emailVerified||!domain||personalDomains.has(domain)||!domain.includes('.')){loading=false;emit();return}companyId=domain;try{const [c,m,r]=await Promise.all([F.getDoc(companyRef()),F.getDoc(memberRef(u.uid)),F.getDoc(requestRef(u.uid))]);if(token!==seq)return;company=c.exists()?c.data():null;member=m.exists()?m.data():null;request=r.exists()?r.data():null;loading=false;emit();if(isApproved()){await refresh();await sync()}}catch(e){if(token!==seq)return;loading=false;notice('Company workspace unavailable: '+(e.code||e.message),true)}}
async function requestAccess(){if(!user||!company||!companyId||request||isApproved())return;const email=user.email.toLowerCase();if(!email.endsWith('@'+companyId)){notice('Your verified email does not match this company domain.',true);return}try{await F.setDoc(requestRef(user.uid),{uid:user.uid,email,name:user.displayName||email,status:'pending',requestedAt:new Date().toISOString()});request={status:'pending'};notice('Request sent. Your company administrator must approve access.')}catch(e){notice('Request failed: '+(e.code||e.message),true)}}
async function approve(uid){if(!isAdmin())return;const r=requests.find(x=>x.uid===uid);if(!r||!r.email?.toLowerCase().endsWith('@'+companyId)){notice('Cannot approve: email domain does not match company.',true);return}try{await F.setDoc(memberRef(uid),{uid,email:r.email.toLowerCase(),name:r.name||r.email,role:'member',status:'active',completed:0,total:0,certifications:[],updatedAt:new Date().toISOString()});await F.deleteDoc(requestRef(uid));notice('Employee approved.');await refresh()}catch(e){notice('Approval failed: '+(e.code||e.message),true)}}
async function reject(uid){if(!isAdmin())return;try{await F.deleteDoc(requestRef(uid));notice('Request declined.');await refresh()}catch(e){notice('Decline failed: '+(e.code||e.message),true)}}
async function revoke(uid){if(!isAdmin()||uid===user.uid||!confirm('Remove this member from the company team?'))return;try{await F.deleteDoc(memberRef(uid));notice('Member access revoked.');await refresh()}catch(e){notice('Removal failed: '+(e.code||e.message),true)}}
async function sync(){if(!user||!company||!isApproved()||active)return;active=true;try{const ref=memberRef(user.uid);if(!member&&isAdmin())return;await F.updateDoc(ref,summary());member={...member,...summary()};const row=members.find(x=>x.uid===user.uid);if(row)Object.assign(row,summary());emit()}catch(e){if(e.code!=='permission-denied')notice('Team summary could not sync: '+(e.code||e.message),true)}finally{active=false}}
const renderMember=m=>`<tr><td>${escapeHTML(m.name||m.email||'Member')}${m.uid===user.uid?' <span class="team-muted">(you)</span>':''}<div class="team-muted">${escapeHTML(m.email||'')}</div></td><td>${Number(m.completed)||0} / ${Number(m.total)||0}</td><td>${(Array.isArray(m.certifications)?m.certifications:[]).map(x=>escapeHTML(x)).join(', ')||'—'}</td>${isAdmin()?`<td>${m.uid!==user.uid?`<button onclick="AcademyTeam.revoke('${escapeHTML(m.uid)}')">Remove</button>`:'—'}</td>`:''}</tr>`;
function html(){if(loading)return '<section class="card team-card"><h1>Team View</h1><p>Checking company membership…</p></section>';
if(!user)return '<section class="card team-card"><h1>Team View</h1><p>Sign in with Google using your verified company email to request access to your organization.</p></section>';
if(!companyId)return '<section class="card team-card"><h1>Team View</h1><p>Personal email accounts use the individual academy. A verified company email is required to request team access.</p></section>';
if(!company)return `<section class="card team-card"><h1>Team View</h1><p class="team-notice">No company workspace is registered for <strong>${escapeHTML(companyId)}</strong>.</p><p class="team-muted">For security, workspaces must be created by the academy owner in Firebase. Employees cannot create their own company administrator.</p></section>`;
const label=escapeHTML(company.name||companyId);
if(!isApproved())return `<section class="card team-card"><h1>${label} · Team View</h1><p>Your verified email: ${escapeHTML(user.email)}</p>${request?'<p class="team-notice">Your request is pending administrator approval. Team members and progress remain private until approval.</p>':'<p>Request access to see certification progress shared by approved coworkers in your company.</p><button class="primary" onclick="AcademyTeam.requestAccess()">Request team access</button>'}${message?`<p class="${error?'team-error':'team-muted'}">${escapeHTML(message)}</p>`:''}</section>`;
const completed=members.reduce((n,m)=>n+(Number(m.completed)||0),0);const badges=members.reduce((n,m)=>n+(Array.isArray(m.certifications)?m.certifications.length:0),0);
return `<div class="team-top"><div><span class="pill">${label}</span><h1>Team certification dashboard</h1><p class="sub">Only approved ${label} team members can view this workspace. Certifications are self-reported.</p></div><button onclick="AcademyTeam.refresh()">Refresh team</button></div><div class="team-grid"><div class="team-metric"><b>${members.length}</b>Approved members</div><div class="team-metric"><b>${badges}</b>Reported certifications</div><div class="team-metric"><b>${completed}</b>Study links completed (total)</div></div><section class="card"><h2>Member progress</h2><div class="team-table-wrap"><table class="team-table"><thead><tr><th>Employee</th><th>Study progress</th><th>Reported badges</th>${isAdmin()?'<th>Admin</th>':''}</tr></thead><tbody>${members.length?members.map(renderMember).join(''):`<tr><td colspan="4">No approved member summaries yet.</td></tr>`}</tbody></table></div></section>${isAdmin()?`<section class="card"><h2>Pending approval requests (${requests.length})</h2>${requests.length?requests.map(r=>`<div class="team-request"><div><strong>${escapeHTML(r.name||r.email)}</strong><div class="team-muted">${escapeHTML(r.email)}</div></div><div class="team-actions"><button class="primary" onclick="AcademyTeam.approve('${escapeHTML(r.uid)}')">Approve</button><button onclick="AcademyTeam.reject('${escapeHTML(r.uid)}')">Decline</button></div></div>`).join(''):'<p class="team-muted">No pending requests.</p>'}</section>`:''}${message?`<p class="${error?'team-error':'team-muted'}">${escapeHTML(message)}</p>`:''}<p class="team-muted">The team view shows study-link completion and self-reported badge codes. Simulator lab and mock-exam history remain private.</p>`;
}
window.AcademyTeam={html,requestAccess,approve,reject,revoke,refresh,sync};
try{const [{initializeApp,getApps,getApp},{getAuth,onAuthStateChanged,setPersistence,browserLocalPersistence},fire]=await Promise.all([import(SDK+'firebase-app.js'),import(SDK+'firebase-auth.js'),import(SDK+'firebase-firestore.js')]);F=fire;const app=getApps().length?getApp():initializeApp(firebaseConfig);auth=getAuth(app);db=fire.getFirestore(app);await setPersistence(auth,browserLocalPersistence);onAuthStateChanged(auth,initialize)}catch(e){loading=false;notice('Team setup unavailable: '+(e.code||e.message),true)}
